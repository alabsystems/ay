(set-option :timeout 90000)
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const acc (_ BitVec 64))
(declare-const t0 (_ BitVec 64))
(declare-const t1 (_ BitVec 64))
(declare-const t2 (_ BitVec 64))
(declare-const t3 (_ BitVec 64))
(assert (not (= (bvmul (bvmul (bvmul (bvmul acc t0) t1) t2) t3) (bvmul (bvmul (bvmul acc t0) t1) (bvmul t2 t3)))))
(check-sat)
(exit)