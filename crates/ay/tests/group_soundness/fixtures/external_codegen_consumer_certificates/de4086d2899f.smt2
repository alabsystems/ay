(set-option :timeout 90000)
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const acc (_ BitVec 8))
(declare-const t0 (_ BitVec 8))
(declare-const t1 (_ BitVec 8))
(declare-const t2 (_ BitVec 8))
(declare-const t3 (_ BitVec 8))
(declare-const t4 (_ BitVec 8))
(declare-const t5 (_ BitVec 8))
(declare-const t6 (_ BitVec 8))
(declare-const t7 (_ BitVec 8))
(assert (not (= (bvmul (bvmul (bvmul (bvmul (bvmul (bvmul (bvmul (bvmul acc t0) t1) t2) t3) t4) t5) t6) t7) (bvmul (bvmul (bvmul (bvmul acc t0) t4) (bvmul t1 t5)) (bvmul (bvmul t2 t6) (bvmul t3 t7))))))
(check-sat)
(exit)