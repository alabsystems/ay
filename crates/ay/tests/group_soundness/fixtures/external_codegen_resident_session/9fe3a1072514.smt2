(set-option :timeout 30000)
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const sa_v71 (_ BitVec 64))
(declare-const sa_v74 (_ BitVec 64))
(declare-const sa_v72 (_ BitVec 64))
(declare-const sa_v70 (_ BitVec 64))
(assert (not (= (bvadd (bvmul (_ bv4 64) sa_v71) sa_v74) (bvadd (bvmul (_ bv4 64) sa_v71) sa_v70))))
(check-sat)
(get-value (sa_v71 sa_v74 sa_v72 sa_v70))
