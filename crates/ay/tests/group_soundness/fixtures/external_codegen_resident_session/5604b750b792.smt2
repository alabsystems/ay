(set-option :timeout 30000)
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const sa_v92 (_ BitVec 64))
(declare-const sa_v90 (_ BitVec 64))
(declare-const sa_v93 (_ BitVec 64))
(declare-const sa_v91 (_ BitVec 64))
(assert (not (= (bvadd (bvmul (_ bv2 64) sa_v92) sa_v90) (bvadd (bvmul (_ bv4 64) sa_v92) sa_v90))))
(check-sat)
(get-value (sa_v92 sa_v90 sa_v93 sa_v91))
