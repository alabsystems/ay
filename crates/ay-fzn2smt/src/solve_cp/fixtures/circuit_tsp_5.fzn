% TSP with 5 cities using circuit constraint
% Distance matrix:
%   0  10  15  20  25
%  10   0  35  25  30
%  15  35   0  30  20
%  20  25  30   0  15
%  25  30  20  15   0
var 1..5: next1 :: output_var;
var 1..5: next2 :: output_var;
var 1..5: next3 :: output_var;
var 1..5: next4 :: output_var;
var 1..5: next5 :: output_var;
var 0..200: total_dist :: output_var;
% Circuit constraint
constraint fzn_circuit([next1, next2, next3, next4, next5]);
% Edge costs via element constraints
% dist from city 1 to next1
var 0..25: d1 :: output_var;
constraint array_int_element(next1, [0, 10, 15, 20, 25], d1);
% dist from city 2 to next2
var 0..35: d2 :: output_var;
constraint array_int_element(next2, [10, 0, 35, 25, 30], d2);
% dist from city 3 to next3
var 0..30: d3 :: output_var;
constraint array_int_element(next3, [15, 35, 0, 30, 20], d3);
% dist from city 4 to next4
var 0..30: d4 :: output_var;
constraint array_int_element(next4, [20, 25, 30, 0, 15], d4);
% dist from city 5 to next5
var 0..30: d5 :: output_var;
constraint array_int_element(next5, [25, 30, 20, 15, 0], d5);
% Total distance
constraint int_lin_eq([1, 1, 1, 1, 1, -1], [d1, d2, d3, d4, d5, total_dist], 0);
solve minimize total_dist;
