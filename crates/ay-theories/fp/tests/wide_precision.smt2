; Closed wide-FP semantic oracle. Expected: unsat.
; All claims are exact, including IEEE zero signs (structural =).
(set-logic QF_FP)
(define-fun one66 () (_ FloatingPoint 2 66) (fp #b0 #b01 (_ bv0 65)))
(define-fun two66 () (_ FloatingPoint 2 66) (fp #b0 #b10 (_ bv0 65)))
(define-fun one130 () (_ FloatingPoint 2 130) (fp #b0 #b01 (_ bv0 129)))
(define-fun two130 () (_ FloatingPoint 2 130) (fp #b0 #b10 (_ bv0 129)))
(define-fun high () (_ FloatingPoint 2 130)
  (fp #b0 #b01 (_ bv340282366920938463463374607431768211456 129)))
(define-fun three () (_ FloatingPoint 2 130)
  (fp #b0 #b10 (_ bv340282366920938463463374607431768211456 129)))
(define-fun one () (_ FloatingPoint 3 130) (fp #b0 #b011 (_ bv0 129)))
(define-fun next () (_ FloatingPoint 3 130) (fp #b0 #b011 (_ bv1 129)))
(define-fun half () (_ FloatingPoint 3 130) (fp #b0 #b000 (_ bv2 129)))
(define-fun tiny () (_ FloatingPoint 3 130) (fp #b0 #b000 (_ bv1 129)))
(define-fun two () (_ FloatingPoint 3 130) (fp #b0 #b100 (_ bv0 129)))
(define-fun maxfinite () (_ FloatingPoint 3 130)
  (fp #b0 #b110 (_ bv680564733841876926926749214863536422911 129)))
(define-fun a () (_ FloatingPoint 10 130) (fp #b0 (_ bv511 10) (_ bv1 129)))
(define-fun b () (_ FloatingPoint 10 130)
  (fp #b0 (_ bv510 10) (_ bv680564733841876926926749214863536422910 129)))
(define-fun minusone () (_ FloatingPoint 10 130) (fp #b1 (_ bv511 10) (_ bv0 129)))
(define-fun fused () (_ FloatingPoint 10 130) (fp #b1 (_ bv253 10) (_ bv0 129)))
(assert (not (and
  (= (fp.add RNE one66 one66) two66)
  (= (fp.add RNE one130 one130) two130)
  (= (fp.add RNE high high) three)
  (= (fp.add RNE one half) one)
  (= (fp.add RNA one half) next)
  (= (fp.add RTP one half) next)
  (= (fp.add RTN one half) one)
  (= (fp.add RTZ one half) one)
  (= (fp.add RTN (fp.neg one) (fp.neg half)) (fp.neg next))
  (= (fp.add RTP (fp.neg one) (fp.neg half)) (fp.neg one))
  (= (fp.div RNE tiny two) (_ +zero 3 130))
  (= (fp.div RNA tiny two) tiny)
  (= (fp.div RTP tiny two) tiny)
  (= (fp.div RTN (fp.neg tiny) two) (fp.neg tiny))
  (= (fp.div RTZ (fp.neg tiny) two) (_ -zero 3 130))
  (= (fp.mul RNE maxfinite two) (_ +oo 3 130))
  (= (fp.mul RTZ maxfinite two) maxfinite)
  (= (fp.mul RTN (fp.neg maxfinite) two) (_ -oo 3 130))
  (= (fp.add RNE one (fp.neg one)) (_ +zero 3 130))
  (= (fp.add RTN one (fp.neg one)) (_ -zero 3 130))
  (= (fp.fma RNE a b minusone) fused)
  (= (fp.add RNE (fp.mul RNE a b) minusone) (_ +zero 10 130))
  (fp.isNaN (fp.mul RNE (_ +zero 3 130) (_ +oo 3 130)))
  (not (fp.eq (_ NaN 3 130) (_ NaN 3 130)))
  (= (_ NaN 3 130) (_ NaN 3 130))
)))
(check-sat)
