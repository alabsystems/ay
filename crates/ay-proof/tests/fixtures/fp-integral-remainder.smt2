; Independent IEEE integral rounding and nearest-even remainder.
(set-logic QF_FP)
(assert (not (and
  (= (fp.roundToIntegral RNE ((_ to_fp 8 24) RNE 2.5)) ((_ to_fp 8 24) RNE 2.0))
  (= (fp.roundToIntegral RNA ((_ to_fp 8 24) RNE 2.5)) ((_ to_fp 8 24) RNE 3.0))
  (= (fp.roundToIntegral RTP ((_ to_fp 8 24) RNE (- 2.5))) ((_ to_fp 8 24) RNE (- 2.0)))
  (= (fp.roundToIntegral RTN ((_ to_fp 8 24) RNE (- 2.5))) ((_ to_fp 8 24) RNE (- 3.0)))
  (= (fp.roundToIntegral RTZ ((_ to_fp 8 24) RNE (- 2.5))) ((_ to_fp 8 24) RNE (- 2.0)))
  (= (fp.roundToIntegral RNE ((_ to_fp 8 24) RNE (- 0.5))) (_ -zero 8 24))
  (= (fp.roundToIntegral RNE (_ +oo 8 24)) (_ +oo 8 24))
  (fp.isNaN (fp.roundToIntegral RNE (_ NaN 8 24)))
  (= (fp.roundToIntegral RNE ((_ to_fp 2 3) RNE 3.5)) (_ +oo 2 3))
  (= (fp.roundToIntegral RTZ ((_ to_fp 2 3) RNE 3.5)) ((_ to_fp 2 3) RNE 3.0))
  (= (fp.rem ((_ to_fp 8 24) RNE 3.0) ((_ to_fp 8 24) RNE 2.0)) ((_ to_fp 8 24) RNE (- 1.0)))
  (= (fp.rem ((_ to_fp 8 24) RNE 5.0) ((_ to_fp 8 24) RNE 2.0)) ((_ to_fp 8 24) RNE 1.0))
  (= (fp.rem ((_ to_fp 8 24) RNE (- 3.0)) ((_ to_fp 8 24) RNE 2.0)) ((_ to_fp 8 24) RNE 1.0))
  (= (fp.rem ((_ to_fp 8 24) RNE (- 4.0)) ((_ to_fp 8 24) RNE 2.0)) (_ -zero 8 24))
  (= (fp.rem ((_ to_fp 8 24) RNE 3.0) (_ +oo 8 24)) ((_ to_fp 8 24) RNE 3.0))
  (fp.isNaN (fp.rem (_ +oo 8 24) ((_ to_fp 8 24) RNE 2.0)))
  (fp.isNaN (fp.rem ((_ to_fp 8 24) RNE 2.0) (_ -zero 8 24)))
)))
(check-sat)
