; Unsat twin: f09_array_divisor.smt2 with one product changed so that the
; forced d = 0 makes both sides of the disequality 0. AY must refute it.
(declare-fun f (Int) Int)
(declare-fun gg (Int Int) Int)
(declare-fun pb (Int) Bool)
(declare-const bq Bool)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const d Int)
(declare-const e Int)
(declare-const A (Array Int Int))
(assert (= (div d d) 5))
(assert (distinct (* (f 0) d) (* x d)))
(assert (>= (* (- x y) (abs 0)) d))
(assert (= (- (* y y) (f (f d))) (div (+ 0 z) (select A (+ (select A x) e)))))
(check-sat)
