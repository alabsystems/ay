(set-option :produce-unsat-cores true)
(set-logic ALL)
(declare-const result (_ BitVec 64))
(declare-const b (_ BitVec 64))
(declare-const a (_ BitVec 64))
(assert (! (bvult a #x00000000000003e8) :named dn0))
(assert (! (bvult b #x00000000000003e8) :named dn1))
(assert (! (= result (bvmul a b)) :named dn2))
(assert (! true :named dn3))
(assert (! (not (= ((_ extract 127 64) (bvmul ((_ zero_extend 64) a) ((_ zero_extend 64) b))) #x0000000000000000)) :named dn4))
(check-sat)
