(set-option :produce-proofs true)
(set-logic ALL)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const d Int)
(declare-fun f (Int) Int)
(assert (forall ((q Int)) (and (distinct b b) (< a -4))))
(assert (not (or (distinct a d) (= a c))))
(assert (forall ((x Int)) (= (f x) c)))
(assert (forall ((x Int)) (= (f x) -5)))
(assert (>= (f (ite (= 1 c) -1 -2)) (+ 3 (+ b d))))
(assert (distinct (f (+ b 4)) (ite (and (> d a) (>= -5 c)) (ite (> 0 c) 4 0) (f c))))
(check-sat)
(get-model)
