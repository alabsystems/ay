; Actual ff-sat tactic plus its model converter, shared with pinned Z3 5.3.3.
; Expected verdicts: sat, unsat, sat, unsat, sat, unsat, unsat, sat.
(set-logic QF_FF)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const x (_ FiniteField 7))
(assert (or p (= x #f1m7)))
(assert (or (not p) (= x #f2m7)))
(assert (= x #f2m7))
(check-sat-using ff-sat)
(get-value (p x))
(reset)
(set-logic QF_FF)
(declare-const p Bool)
(declare-const x (_ FiniteField 7))
(assert (or p (= x #f1m7)))
(assert (or (not p) (= x #f2m7)))
(assert (= x #f3m7))
(check-sat-using ff-sat)
(reset)
(set-logic QF_FF)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const x (_ FiniteField 65537))
(assert (or p (= (ff.mul x x) #f1m65537)))
(assert (or (not p) (= (ff.mul x x) #f4m65537)))
(assert (= x #f2m65537))
(check-sat-using ff-sat)
(get-value (p x))
(reset)
(set-logic QF_FF)
(declare-const p Bool)
(declare-const x (_ FiniteField 65537))
(assert (or p (= (ff.mul x x) #f1m65537)))
(assert (or (not p) (= (ff.mul x x) #f4m65537)))
(assert (= x #f3m65537))
(check-sat-using ff-sat)
(reset)
(set-logic QF_FF)
(set-option :produce-models true)
(declare-const x (_ FiniteField 2))
(assert (not (= x #f0m2)))
(check-sat-using ff-sat)
(get-value (x))
(reset)
(set-logic QF_FF)
(declare-const x (_ FiniteField 2))
(assert (= (ff.mul x x) #f0m2))
(assert (not (= x #f0m2)))
(check-sat-using ff-sat)
(reset)
(declare-const p Bool)
(declare-const q Bool)
(assert (or p q))
(assert (or (not p) q))
(assert (not q))
(check-sat-using ff-sat)
(reset)
(set-logic QF_FF)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const x (_ FiniteField 7))
(assert (= x #f2m7))
(assert (ite (= x #f1m7) p (not p)))
(assert (= p (= x #f1m7)))
(assert (xor p (= x #f2m7)))
(check-sat-using ff-sat)
(get-value (p x))
