(set-logic ALL)
(set-option :produce-models true)
(declare-const x (_ FiniteField 7))
(declare-const y (_ FiniteField 7))
(assert (= x #f3m7))
(assert (= (ff.add x y) #f2m7))
(apply ff-simplify)
(check-sat)
(get-value (x y))
(push 1)
(assert (not (= y #f6m7)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (ff.bitsum #f1m7 #f2m7 #f3m7) #f3m7)))
(check-sat)
(pop 1)
(push 1)
(assert (= x #f6m7))
(check-sat)
