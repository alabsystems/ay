(set-option :timeout 60000)
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const func_start (_ BitVec 64))
(declare-const region_start (_ BitVec 64))
(declare-const length (_ BitVec 64))
(declare-const landing_pad (_ BitVec 64))
(declare-const type_filter (_ BitVec 64))
(declare-const pc (_ BitVec 64))
(assert (and (bvsgt type_filter (_ bv0 64)) (and (and (bvule region_start pc) (bvult pc (bvadd length region_start))) (and (bvugt (bvadd length region_start) region_start) (not (= (bvadd func_start landing_pad) (ite (and (and (bvule region_start pc) (bvult pc (bvadd length region_start))) (bvsgt type_filter (_ bv0 64))) (bvadd func_start landing_pad) (_ bv0 64))))))))
(check-sat)
(exit)