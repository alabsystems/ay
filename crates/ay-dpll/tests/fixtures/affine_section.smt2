(set-option :timeout 60000)
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const SectObj (_ BitVec 64))
(declare-const SectFinal (_ BitVec 64))
(declare-const off (_ BitVec 64))
(assert (not (= (bvadd SectFinal off) (bvadd (bvsub (bvadd SectObj off) SectObj) SectFinal))))
(check-sat)
(exit)