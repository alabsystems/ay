(assert (! (=> (has_type (mref_update_current ty_dec_nil ty_bool v0 (box_bool true)) (ty_mut_ref ty_dec_nil ty_bool)) (has_type (mref_current ty_dec_nil ty_bool (mref_update_current ty_dec_nil ty_bool v0 (box_bool true))) ty_bool)) :named qh19))
