(set-logic ALL)
(declare-const s String)
(declare-const xs (Seq Int))
(set-option :rewriter.max_power_expansion 2)
(simplify (str.power s 3))
(set-option :rewriter.max_power_expansion 4)
(simplify (str.power s 3))
(set-option :rewriter.max_power_expansion 2)
(simplify (str.power "ab" 3))
(set-option :rewriter.max_power_expansion 4)
(simplify (str.power "ab" 3))
(set-option :rewriter.max_power_expansion 2)
(simplify (seq.power xs 3))
(set-option :rewriter.max_power_expansion 4)
(simplify (seq.power xs 3))
(set-option :rewriter.max_power_expansion 0)
(simplify (str.power s (- 1)))
(set-option :rewriter.max_power_expansion 0)
(simplify (str.power s 1))
(push)
(assert (= s "ab"))
(assert (distinct (str.power s 3) "ababab"))
(check-sat)
(pop)
(assert (= s "ab"))
(check-sat)
(get-value ((str.power s 3)))
