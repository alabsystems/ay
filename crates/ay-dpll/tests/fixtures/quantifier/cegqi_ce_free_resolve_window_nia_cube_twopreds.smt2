(set-logic ALL)
(set-info :status sat)
(declare-sort V 0)
(declare-fun P (V) Bool)
(declare-fun Q (V) Bool)
(declare-const b Int)
(declare-const c Int)
(assert (forall ((v V)) (or (P v) (Q v))))
(assert (forall ((v V) (w V)) (or (not (P v)) (Q w))))
(assert (> b 6))
(assert (> c 1))
(assert (forall ((y Int)) (or (> c 0) (> (* y y) 4))))
(assert (forall ((x Int)) (or (> b 5) (> (* x x x) 8))))
(check-sat)
