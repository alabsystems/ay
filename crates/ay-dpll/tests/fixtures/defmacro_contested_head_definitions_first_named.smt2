(set-option :produce-proofs true)
(set-option :produce-unsat-cores true)
(set-logic ALL)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const d Int)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(assert (! (forall ((x Int) (y Int)) (= (g x y) (f (f x)))) :named n1))
(assert (! (forall ((x Int) (y Int)) (= (g x y) a)) :named n2))
(assert (! (forall ((x Int)) (= (f x) (* 2 (g x d)))) :named n3))
(assert (distinct (f 2) (g 5 2) (+ c c)))
(assert (distinct b (+ a (- 4)) (+ 5 a)))
(assert (distinct (+ a d) (+ c c) (* 3 d)))
(check-sat)
(get-unsat-core)
