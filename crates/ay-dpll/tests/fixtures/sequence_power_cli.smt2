(declare-const s String)
(declare-const n Int)
(get-option :rewriter.max_power_expansion)
(simplify (str.power "ab" 3))
(set-option :rewriter.max_power_expansion 1)
(simplify (seq.power (seq.power s 3) 2))
(simplify (seq.power (seq.power s 3) n))
(declare-const k Int)
(simplify (seq.power (seq.power s k) n))
(simplify (seq.power (seq.power s 3) (- 2)))
(get-option :rewriter.max_power_expansion)
(simplify (str.power "ab" 3))
(reset)
(get-option :rewriter.max_power_expansion)
(simplify (str.power "ab" 3))
