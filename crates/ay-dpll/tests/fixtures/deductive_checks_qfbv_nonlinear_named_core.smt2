(set-option :produce-unsat-cores true)
(set-logic ALL)
(declare-const z (_ BitVec 32))
(declare-const y (_ BitVec 32))
(declare-const x (_ BitVec 32))
(assert (! (bvule x #x0000ffff) :named dn0))
(assert (! (bvule y #x0000ffff) :named dn1))
(assert (! (bvule z #x0000ffff) :named dn2))
(assert (! true :named dn3))
(assert (! (bvsle (bvmul x z) #xfffe0001) :named dn4))
(assert (! true :named dn5))
(assert (! true :named dn6))
(assert (! (bvsle (bvmul y z) #xfffe0001) :named dn7))
(assert (! true :named dn8))
(assert (! (not (= #x00000000 ((_ extract 63 32) (bvmul ((_ zero_extend 32) x) ((_ zero_extend 32) z))))) :named dn9))
(check-sat)
