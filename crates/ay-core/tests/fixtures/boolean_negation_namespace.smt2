; Logical oracle for the raw-constructor namespace regressions.
; Fresh opaque names represent the test's declared AND/OR interpretations;
; SMT-LIB builtin spellings are not redeclared in this reference input.
(set-logic QF_UF)
(define-fun opaque_and ((x Bool) (y Bool)) Bool false)
(assert (not (opaque_and false false)))
(check-sat)
(reset)
(set-logic QF_UF)
(define-fun opaque_and ((x Bool) (y Bool)) Bool true)
(assert (not (opaque_and false false)))
(check-sat)
(reset)
(set-logic QF_UF)
(define-fun opaque_or ((x Bool) (y Bool)) Bool false)
(assert (not (opaque_or true true)))
(check-sat)
(reset)
(set-logic QF_UF)
(define-fun opaque_or ((x Bool) (y Bool)) Bool true)
(assert (not (opaque_or true true)))
(check-sat)
(reset)
(set-logic QF_UF)
(declare-const x Bool)
(declare-const y Bool)
(assert (not (= (not (and x y)) (or (not x) (not y)))))
(check-sat)
(reset)
(set-logic QF_UF)
(declare-const x Bool)
(declare-const y Bool)
(assert (not (= (not (or x y)) (and (not x) (not y)))))
(check-sat)
