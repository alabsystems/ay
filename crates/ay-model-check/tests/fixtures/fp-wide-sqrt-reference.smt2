; Independently specified SB200 identities. UNSAT means no wrong-result claim.
; IEEE-754 square-root rounding: exact integer midpoint comparisons.
(set-logic QF_FPBV)
(define-fun one () (_ FloatingPoint 8 200) (fp #b0 #x7f (_ bv0 199)))
(define-fun next () (_ FloatingPoint 8 200) (fp #b0 #x7f (_ bv1 199)))
(define-fun next2 () (_ FloatingPoint 8 200) (fp #b0 #x7f (_ bv2 199)))
(define-fun square () (_ FloatingPoint 8 200)
  (fp #b0 #x7f (bvor (bvshl (_ bv1 199) (_ bv110 199))
                      (bvshl (_ bv1 199) (_ bv19 199)))))
(define-fun root () (_ FloatingPoint 8 200)
  (fp #b0 #x7f (bvshl (_ bv1 199) (_ bv109 199))))
(define-fun sub () (_ FloatingPoint 8 200) (fp #b0 #x00 (_ bv2 199)))
(define-fun subroot () (_ FloatingPoint 8 200)
  (fp #b0 #x00 (bvshl (_ bv1 199) (_ bv163 199))))
(define-fun below4 () (_ FloatingPoint 8 200) (fp #b0 #x80 (bvnot (_ bv0 199))))
(define-fun below2 () (_ FloatingPoint 8 200) (fp #b0 #x7f (bvnot (_ bv0 199))))
(define-fun two () (_ FloatingPoint 8 200) (fp #b0 #x80 (_ bv0 199)))
(define-fun good ((r RoundingMode) (low (_ FloatingPoint 8 200))
                  (high (_ FloatingPoint 8 200)) (carry (_ FloatingPoint 8 200))) Bool
  (and (= (fp.sqrt r next) low)
       (= (fp.sqrt r next2) high)
       (= (fp.sqrt r square) root)
       (= (fp.sqrt r sub) subroot)
       (= (fp.sqrt r below4) carry)
       (= (fp.sqrt r (_ -zero 8 200)) (_ -zero 8 200))
       (= (fp.sqrt r (_ +zero 8 200)) (_ +zero 8 200))
       (= (fp.sqrt r (_ +oo 8 200)) (_ +oo 8 200))
       (= (fp.sqrt r (_ -oo 8 200)) (_ NaN 8 200))
       (= (fp.sqrt r (fp.neg one)) (_ NaN 8 200))
       (= (fp.sqrt r (_ NaN 8 200)) (_ NaN 8 200))))
(assert (not (and (good RNE one next below2)
                  (good RNA one next below2)
                  (good RTP next next two)
                  (good RTN one one below2)
                  (good RTZ one one below2))))
(check-sat)
