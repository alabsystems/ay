; Expected: sat, unsat, sat, unsat through the actual propagation tactic.
(set-logic QF_FP)
(declare-const x (_ FloatingPoint 8 200))
(assert (= x ((_ to_fp 8 200) RNE 5.0)))
(push 1)
(assert (= (fp.rem x ((_ to_fp 8 200) RNE 3.0)) ((_ to_fp 8 200) RNE (- 1))))
(check-sat-using (then propagate-values smt))
(pop 1)
(push 1)
(assert (= (fp.rem x ((_ to_fp 8 200) RNE 3.0)) (_ +zero 8 200)))
(check-sat-using (then propagate-values smt))
(pop 1)
(declare-const z (_ FloatingPoint 8 200))
(assert (= z (_ +zero 8 200)))
(push 1)
(assert (fp.eq z (_ -zero 8 200)))
(check-sat-using (then propagate-values smt))
(pop 1)
(push 1)
(assert (= z (_ -zero 8 200)))
(check-sat-using (then propagate-values smt))
(pop 1)
