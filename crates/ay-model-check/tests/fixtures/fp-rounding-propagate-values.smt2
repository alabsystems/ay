; Expected: sat, unsat, sat, sat. A free mode is never guessed to be RNE.
(set-logic QF_FP)
(declare-const mode RoundingMode)
(define-fun rounded () (_ FloatingPoint 11 53)
  (fp.add mode ((_ to_fp 11 53) RNE 1.0)
    ((_ to_fp 11 53) RNE (/ 1 18014398509481984))))
(push 1)
(assert (= mode RTP))
(assert (= rounded ((_ to_fp 11 53) RNE (/ 4503599627370497 4503599627370496))))
(check-sat-using (then propagate-values smt))
(pop 1)
(push 1)
(assert (= mode RTP))
(assert (= rounded ((_ to_fp 11 53) RNE 1.0)))
(check-sat-using (then propagate-values smt))
(pop 1)
(push 1)
(assert (= rounded ((_ to_fp 11 53) RNE (/ 4503599627370497 4503599627370496))))
(check-sat-using (then propagate-values smt))
(pop 1)
(push 1)
(assert (= rounded ((_ to_fp 11 53) RNE 1.0)))
(check-sat-using (then propagate-values smt))
(pop 1)
