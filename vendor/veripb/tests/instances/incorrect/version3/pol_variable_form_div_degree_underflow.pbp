pseudo-Boolean proof version 3.0
% Regression test: `c` (variable-form division) moves negated literals to the
% right-hand side, which underflowed the i64 degree and produced `>= 1` from a
% trivially true constraint.
f 2 ;
rup 1 ~x1 >= -9223372036854775808 ;
