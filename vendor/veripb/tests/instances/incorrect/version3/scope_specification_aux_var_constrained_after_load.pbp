pseudo-Boolean proof version 3.0
% Regression test (wrong verdict): the second spelling of
% scope_specification_aux_var_not_fresh -- the constraint over the order's
% auxiliary variable is added AFTER `load_order`, where
% `checker::validate_aux_var` does run but passes, because `$q` IS an auxiliary
% variable of the active order. So a `load_order`-time freshness check would
% not have been enough; the check belongs where the specification premises are
% introduced, which is what `ScopeRule` now does.
f 2;
def_order o
  vars
    left u1;
    right v1;
    aux $q;
  end;
  spec
    red +1 $q >= 1 : $q -> 1;
  end;
  def
    +1 ~u1 +1 v1 >= 1;
  end;
  transitivity
    vars
      fresh_right w1;
      fresh_aux_1 $b1;
      fresh_aux_2 $c1;
    end;
    proof
      proofgoal #1
        rup >= 1;
      qed;
    qed;
  end;
end;
load_order o x1;
red +1 ~$q >= 1 : $q -> 0 ;
dom +1 ~x1 >= 1 : x1 -> 1 : subproof
  scope leq
    proofgoal #1
      rup >= 1;
    qed;
  end scope;
  scope geq
    proofgoal #2
      rup >= 1;
    qed;
  end scope;
qed;
rup >= 1;
output NONE;
conclusion UNSAT : -1;
end pseudo-Boolean proof;
