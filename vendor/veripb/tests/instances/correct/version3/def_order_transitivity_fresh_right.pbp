pseudo-Boolean proof version 3.0
% Positive companion to the def_order_transitivity_fresh_right_* instances under
% incorrect/version3: the same shape of order, but genuinely transitive and with
% a `fresh_right` list that is the right length and really fresh, so
% `OrderContext::check_transitivity_variables` must let it through and the
% transitivity proofgoals must still be discharged by the substituted premises.
%
% The order is the componentwise implication `u <= v` on three variables. With
% `fresh_right w1 w2 w3` the goals are `~ui + wi >= 1`, each of which follows by
% RUP from the premises `~ui + vi >= 1` (the order under u,v) and
% `~vi + wi >= 1` (the order under v,w). Reflexivity is trivial (`~ui + ui >= 1`)
% and is autoproven.
f 4;
def_order impl3
  vars
    left u1 u2 u3;
    right v1 v2 v3;
    aux;
  end;
  def
    1 ~u1 1 v1 >= 1;
    1 ~u2 1 v2 >= 1;
    1 ~u3 1 v3 >= 1;
  end;
  transitivity
    vars
      fresh_right w1 w2 w3;
    end;
    proof
      proofgoal #1
        rup >= 1;
      qed;
      proofgoal #2
        rup >= 1;
      qed;
      proofgoal #3
        rup >= 1;
      qed;
    qed;
  end;
end;
load_order impl3 x1 x2 x3;
output NONE;
conclusion NONE;
end pseudo-Boolean proof;
