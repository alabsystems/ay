* #variable= 4 #constraint= 4
preserved: x5 x3 x3 x5 x3 ;
* the preserve set is taken to be the SET of variables
* i.e., removing duplicates and ignoring order
* the proof defines x5 = x1
1 x1 1 ~x5 >= 1 ;
1 x1 1 ~x5 >= 1 ;
1 x1 1 ~x5 >= 1 ;
1 x1 1 ~x5 >= 1 ;
1 x1 +1 x2 >= 1 ;
1 x2 +1 x3 >= 1 ;
1 x1 +1 x3 +1 x4 >= 1 ;
1 x1 +1 x3 -1 x4 >= 0 ;
1 ~x1 1 x5 >= 1 ;
1 ~x1 1 x5 >= 1 ;
1 ~x1 1 x5 >= 1 ;
1 ~x1 1 x5 >= 1 ;
1 x1 1 ~x5 >= 1 ;
