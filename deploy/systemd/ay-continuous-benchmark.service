[Unit]
Description=AY continuous integration and competition benchmark cycle
Documentation=file:%h/.local/share/ay-continuous/repo/docs/CONTINUOUS_BENCHMARKING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/ay-continuous/repo
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CC=ay-zig-cc
Environment=CXX=ay-zig-cxx
Environment=CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=ay-zig-cc
# Host-local latest.json/latest.md and the isolated continuous/status branch
# are updated at every checkpoint. Add --publish-issue after granting the
# service identity GitHub Issues read/write access.
ExecStart=/usr/bin/python3 %h/.local/share/ay-continuous/repo/scripts/continuous_benchmark.py --repo %h/.local/share/ay-continuous/repo cycle --state-root %h/.local/state/ay-continuous --push --publish-status-branch
Nice=10
IOSchedulingClass=idle
OOMPolicy=stop
MemoryHigh=40G
MemoryMax=44G
LimitFSIZE=10G
TasksMax=4096
TimeoutStartSec=3h45min
KillMode=control-group

# Do not enable PrivateTmp: every AY harness must contend on the shared
# /tmp/ay-oom-guard-<uid>.lock host lease.
NoNewPrivileges=true

[Install]
WantedBy=default.target
