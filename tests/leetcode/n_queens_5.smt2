; LeetCode #51: N-Queens, N = 5
; qR is the column (1..5) of the queen in row R. Distinct columns and no
; two queens on a shared diagonal: |qA - qB| != |A - B|.
(set-option :produce-models true)
(set-logic QF_LIA)
(declare-const q1 Int)
(declare-const q2 Int)
(declare-const q3 Int)
(declare-const q4 Int)
(declare-const q5 Int)
(assert (and (<= 1 q1) (<= q1 5)))
(assert (and (<= 1 q2) (<= q2 5)))
(assert (and (<= 1 q3) (<= q3 5)))
(assert (and (<= 1 q4) (<= q4 5)))
(assert (and (<= 1 q5) (<= q5 5)))
(assert (distinct q1 q2 q3 q4 q5))
(assert (and (not (= (- q1 q2) 1)) (not (= (- q2 q1) 1))))
(assert (and (not (= (- q1 q3) 2)) (not (= (- q3 q1) 2))))
(assert (and (not (= (- q1 q4) 3)) (not (= (- q4 q1) 3))))
(assert (and (not (= (- q1 q5) 4)) (not (= (- q5 q1) 4))))
(assert (and (not (= (- q2 q3) 1)) (not (= (- q3 q2) 1))))
(assert (and (not (= (- q2 q4) 2)) (not (= (- q4 q2) 2))))
(assert (and (not (= (- q2 q5) 3)) (not (= (- q5 q2) 3))))
(assert (and (not (= (- q3 q4) 1)) (not (= (- q4 q3) 1))))
(assert (and (not (= (- q3 q5) 2)) (not (= (- q5 q3) 2))))
(assert (and (not (= (- q4 q5) 1)) (not (= (- q5 q4) 1))))
(check-sat)
(get-model)
