; Graph Coloring: 6 western US states, 3 colors (classic map-coloring CSP).
; Nodes: WA, OR, ID, NV, UT, AZ ("or" is an SMT-LIB keyword, hence or_).
; Edges: WA-OR, WA-ID, OR-ID, OR-NV, ID-NV, ID-UT, NV-UT, NV-AZ, UT-AZ.
(set-option :produce-models true)
(set-logic QF_LIA)
(declare-const wa Int)
(declare-const or_ Int)
(declare-const id Int)
(declare-const nv Int)
(declare-const ut Int)
(declare-const az Int)
(assert (and (<= 1 wa) (<= wa 3)))
(assert (and (<= 1 or_) (<= or_ 3)))
(assert (and (<= 1 id) (<= id 3)))
(assert (and (<= 1 nv) (<= nv 3)))
(assert (and (<= 1 ut) (<= ut 3)))
(assert (and (<= 1 az) (<= az 3)))
(assert (distinct wa or_))
(assert (distinct wa id))
(assert (distinct or_ id))
(assert (distinct or_ nv))
(assert (distinct id nv))
(assert (distinct id ut))
(assert (distinct nv ut))
(assert (distinct nv az))
(assert (distinct ut az))
(check-sat)
(get-model)
