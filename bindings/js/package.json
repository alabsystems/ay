{
  "name": "ayz3",
  "version": "0.19.0",
  "description": "Z3-shaped and declarative finite-domain Node APIs backed by the AY solver.",
  "type": "module",
  "main": "ayz3.mjs",
  "exports": {
    ".": "./ayz3.mjs",
    "./lib": "./_lib.mjs",
    "./search": {
      "types": "./search.d.ts",
      "import": "./search.mjs"
    }
  },
  "files": [
    "ayz3.mjs",
    "_lib.mjs",
    "search.mjs",
    "search.d.ts",
    "examples",
    "README.md",
    "test.mjs",
    "test-search.mjs"
  ],
  "scripts": {
    "test": "node test.mjs && node test-search.mjs"
  },
  "keywords": [
    "smt",
    "solver",
    "z3",
    "ay",
    "sat",
    "ffi",
    "constraint-programming",
    "optimization",
    "search",
    "koffi",
    "wasm"
  ],
  "author": "Andrew Yates",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "koffi": "^3.1.0"
  }
}
