c Tseitin formula on a 3x3 grid graph with odd parity
c Known UNSAT - exercises clause learning and resolution
c Edge variables: 12 edges in a 3x3 grid
c XOR constraints at each vertex (odd parity = UNSAT for even graph)
c Encoded using standard CNF XOR encoding
c
c Grid layout (vertices 1-9, edges e1-e12):
c  1 --e1-- 2 --e2-- 3
c  |        |        |
c  e3       e4       e5
c  |        |        |
c  4 --e6-- 5 --e7-- 6
c  |        |        |
c  e8       e9       e10
c  |        |        |
c  7 --e11- 8 --e12- 9
c
c Variables 1-12 = edges e1-e12
c Each interior vertex has XOR = 1 (odd parity)
c This is UNSAT because the sum of all parities is odd
c but each edge contributes to exactly 2 vertices (even total).
p cnf 12 40
c Vertex 1 (edges e1, e3): XOR(1,3) = 1
c  (1 OR 3) AND (-1 OR -3)
1 3 0
-1 -3 0
c Vertex 2 (edges e1, e2, e4): XOR(1,2,4) = 1
c  3-var XOR = 1 encoded as 4 clauses
1 2 4 0
1 -2 -4 0
-1 2 -4 0
-1 -2 4 0
c Vertex 3 (edges e2, e5): XOR(2,5) = 1
2 5 0
-2 -5 0
c Vertex 4 (edges e3, e6, e8): XOR(3,6,8) = 1
3 6 8 0
3 -6 -8 0
-3 6 -8 0
-3 -6 8 0
c Vertex 5 (edges e4, e6, e7, e9): XOR(4,6,7,9) = 1
c  4-var XOR = 1 encoded as 8 clauses
4 6 7 9 0
4 6 -7 -9 0
4 -6 7 -9 0
4 -6 -7 9 0
-4 6 7 -9 0
-4 6 -7 9 0
-4 -6 7 9 0
-4 -6 -7 -9 0
c Vertex 6 (edges e5, e7, e10): XOR(5,7,10) = 1
5 7 10 0
5 -7 -10 0
-5 7 -10 0
-5 -7 10 0
c Vertex 7 (edges e8, e11): XOR(8,11) = 1
8 11 0
-8 -11 0
c Vertex 8 (edges e9, e11, e12): XOR(9,11,12) = 1
9 11 12 0
9 -11 -12 0
-9 11 -12 0
-9 -11 12 0
c Vertex 9 (edges e10, e12): XOR(10,12) = 1
10 12 0
-10 -12 0
