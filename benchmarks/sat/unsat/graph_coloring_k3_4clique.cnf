c Graph 3-coloring of a 4-clique (K4)
c Known UNSAT - K4 requires 4 colors, 3 is insufficient
c Variables: x_{v,c} = vertex v gets color c
c Vertex 1: vars 1,2,3 (colors R,G,B)
c Vertex 2: vars 4,5,6
c Vertex 3: vars 7,8,9
c Vertex 4: vars 10,11,12
p cnf 12 28
c Each vertex gets at least one color
1 2 3 0
4 5 6 0
7 8 9 0
10 11 12 0
c Adjacent vertices get different colors
c Edge (1,2): colors must differ
-1 -4 0
-2 -5 0
-3 -6 0
c Edge (1,3): colors must differ
-1 -7 0
-2 -8 0
-3 -9 0
c Edge (1,4): colors must differ
-1 -10 0
-2 -11 0
-3 -12 0
c Edge (2,3): colors must differ
-4 -7 0
-5 -8 0
-6 -9 0
c Edge (2,4): colors must differ
-4 -10 0
-5 -11 0
-6 -12 0
c Edge (3,4): colors must differ
-7 -10 0
-8 -11 0
-9 -12 0
