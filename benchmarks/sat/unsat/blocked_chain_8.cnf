c Blocked implication chain: 8 variables
c Known UNSAT - forces x1=T, propagates through implications to x8=T,
c but also forces x8=F
c Exercises unit propagation and BCP
p cnf 8 9
c Force x1 = true
1 0
c Implications: x1 => x2, x2 => x3, ..., x7 => x8
-1 2 0
-2 3 0
-3 4 0
-4 5 0
-5 6 0
-6 7 0
-7 8 0
c Force x8 = false (contradiction)
-8 0
