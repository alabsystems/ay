; Store chain: write values at specific indices
(declare-fun idx () (_ BitVec 32))
(declare-fun val1 () (_ BitVec 8))
(declare-fun val2 () (_ BitVec 8))

; Build store chain
(declare-fun arr2 () (Array (_ BitVec 32) (_ BitVec 8)))
(assert (= arr2 (store arr idx val1)))

; Select from the store chain at the same index must give val1
(assert (not (= (select arr2 idx) val1)))

(check-sat)
