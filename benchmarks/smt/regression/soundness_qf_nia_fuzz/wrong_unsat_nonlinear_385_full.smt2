; AY=unsat z3=sat (SOUNDNESS CONFLICT)
(set-logic QF_NIA)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const n Int)
(declare-const m Int)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(declare-const s Bool)
(assert (and (<= -1 n) (<= n 2)))
(assert (and (<= 0 m) (<= m 0)))
(assert (and (not (distinct (ite s z m) (* 1 z x))) p))
(assert (distinct (* y z) (* x n) (* n z)))
(assert (or (< y (* y z n)) (ite (> (ite false y z) (* -2 n y)) (ite (not q) (> 2 y) (=> q false)) (not (not r)))))
(assert (< (* -1 x n) (* n m)))
(assert (<= (- m (- (+ n m) (- z y))) (+ (- (* 0 n m) (ite p -2 y)) y)))
(assert (< (+ (* z z) -1) (* n n)))
(check-sat)
