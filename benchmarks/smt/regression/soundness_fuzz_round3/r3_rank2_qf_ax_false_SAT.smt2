(set-logic QF_AX)
(declare-sort Index 0)
(declare-sort Elem 0)
(declare-const c (Array Index Elem))
(declare-const i0 Index)
(declare-const i1 Index)
(declare-const e0 Elem)
(declare-const e3 Elem)
(declare-const ed Elem)
(assert (distinct i0 i1))
(assert (distinct e3 e0))
(assert (= ((as const (Array Index Elem)) ed) (store (store c i0 e3) i1 e0)))
(check-sat)
