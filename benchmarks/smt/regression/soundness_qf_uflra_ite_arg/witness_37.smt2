; AY=unsat z3=sat (SOUNDNESS CONFLICT)
(set-logic QF_UFLRA)
(declare-sort U 0)
(declare-const x Real)
(declare-const y Real)
(declare-const z Real)
(declare-const n Real)
(declare-const m Real)
(declare-fun fa (Real) Real)
(declare-fun ga (Real) Real)
(declare-fun pa (Real) Bool)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(declare-const s Bool)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-fun fu (U) U)
(declare-fun mem (U Bool) U)
(declare-fun ub (U) Bool)
(assert (= (ga (- z m)) (- (fa (* 3 m)) (ite (ub a) (ite false n -1) (* -3 -3)))))
(assert (>= (ite q -2 z) (ga z)))
(assert (ub (fu c)))
(check-sat)
