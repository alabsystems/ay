(set-logic QF_ALIA)
; Incremental push/pop with QF_ALIA
(declare-const a (Array Int Int))
(declare-const i Int)
(push 1)
(assert (= (select a i) 5))
(assert (> i 0))
(check-sat)
(pop 1)
(push 1)
(assert (= (select a 0) 10))
(assert (= (select a 1) 20))
(assert (> (select a 0) (select a 1)))
(check-sat)
(pop 1)
(exit)
