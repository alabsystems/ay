(set-logic QF_UF)
(declare-sort U 0)
(declare-fun TRUE () U)
(declare-fun FALSE () U)
(declare-fun BOOL () U)
(declare-fun bool (Bool) U)
(declare-fun mem (U U) Bool)
(declare-fun g639 () U)
(declare-fun g640 () U)
(declare-fun P1 () Bool)
(assert (mem TRUE BOOL))
(assert (= (bool (and P1 (= g639 TRUE) (= g640 TRUE))) TRUE))
(assert (= g639 FALSE))
(assert (not (mem (bool (and P1 (= g639 TRUE) (= g640 FALSE))) BOOL)))
(check-sat)
