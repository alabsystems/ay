(set-logic QF_AX)
(declare-sort Index 0)
(declare-sort Elem 0)
(declare-const i0 Index)
(declare-const i2 Index)
(declare-const e0 Elem)
(declare-const e1 Elem)
(declare-const e4 Elem)
(declare-const a1 (Array Index Elem))
(assert (distinct i0 i2))
(assert (distinct e0 e1))
(assert (= (store ((as const (Array Index Elem)) e0) i0 e4)
           (store (store a1 i2 e1) i0 e4)))
(check-sat)
