(set-logic QF_SLIA)
(declare-const s String)(declare-const t String)(declare-const u String)(declare-const v String)(declare-const w String)
(declare-const i Int)(declare-const j Int)(declare-const k Int)(declare-const m Int)(declare-const n Int)
(assert (= u "cba"))
(assert (= t "09"))
(assert (= j 4))
(assert (str.prefixof (str.from_code (+ (str.to_code w) (* 5 k))) (str.at (str.++ (str.at s k) (str.++ w w "09") (str.++ v u)) (* -1 (+ -2 n)))))
(assert (str.prefixof (ite (str.<= (str.from_code j) (str.substr v k k)) (str.from_int (str.to_int u)) (str.from_code m)) (str.++ (str.from_code (str.len t)) (str.substr (str.substr "99" 0 i) (+ 0 j) (str.indexof v u n)))))
(assert (or (<= (str.len (str.substr "9" j i)) (str.len (str.++ "11" t u))) (not (not (= s s)))))
(check-sat)
