; Cross-swap at 2 indices, using let instead of declare-fun
(set-logic QF_AX)
(set-info :status unsat)
(declare-sort Index 0)
(declare-sort Element 0)
(declare-fun a1 () (Array Index Element))
(declare-fun a2 () (Array Index Element))
(declare-fun i1 () Index)
(declare-fun i2 () Index)
; v0 = store(a2, i1, a1[i1])
; v1 = store(a1, i1, a2[i1])
; result: store(v1, i2, v0[i2]) = store(v0, i2, v1[i2])
; plus a1 != a2
(assert (let ((?v_0 (store a2 i1 (select a1 i1)))
              (?v_1 (store a1 i1 (select a2 i1))))
          (= (store ?v_1 i2 (select ?v_0 i2))
             (store ?v_0 i2 (select ?v_1 i2)))))
(assert (not (= a1 a2)))
(check-sat)
(exit)
