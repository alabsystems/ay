; ROW2 basic: i != j -> select(store(a, i, v), j) = select(a, j)
; Expected: unsat
(set-logic QF_AX)
(declare-sort Index 0)
(declare-sort Element 0)
(declare-fun a () (Array Index Element))
(declare-fun i () Index)
(declare-fun j () Index)
(declare-fun v () Element)
(assert (not (= i j)))
(assert (not (= (select (store a i v) j) (select a j))))
(check-sat)
(exit)
