; Even simpler: swap at just one index between two arrays
; v0 = a2 with a1[i] at position i  (= store(a2, i, select(a1, i)))
; v1 = a1 with a2[i] at position i  (= store(a1, i, select(a2, i)))
; Assert v0 = v1 and a1 != a2 => UNSAT?
(set-logic QF_AX)
(set-info :status unsat)
(declare-sort Index 0)
(declare-sort Element 0)
(declare-fun a1 () (Array Index Element))
(declare-fun a2 () (Array Index Element))
(declare-fun i () Index)
(declare-fun v0 () (Array Index Element))
(assert (= v0 (store a2 i (select a1 i))))
(declare-fun v1 () (Array Index Element))
(assert (= v1 (store a1 i (select a2 i))))
(assert (= v0 v1))
(assert (not (= a1 a2)))
(check-sat)
(exit)
