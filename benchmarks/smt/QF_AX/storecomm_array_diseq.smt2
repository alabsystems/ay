; Store commutativity: assert the two arrays are NOT equal (requires extensionality)
; Expected: unsat
(set-logic QF_AX)
(set-info :status unsat)
(declare-sort Index 0)
(declare-sort Elem 0)
(declare-fun a () (Array Index Elem))
(declare-fun i () Index)
(declare-fun j () Index)
(declare-fun v () Elem)
(declare-fun w () Elem)
(assert (not (= i j)))
; Assert the two store orderings are NOT equal (this requires extensionality axiom)
(assert (not (= (store (store a i v) j w) (store (store a j w) i v))))
(check-sat)
(exit)
