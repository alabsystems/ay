(set-logic QF_AUFLIA)
; Overwriting a store: store(store(a,i,v),i,w) = store(a,i,w)
(declare-fun a () (Array Int Int))
(declare-fun i () Int)
(declare-fun v () Int)
(declare-fun w () Int)
(assert (not (= (store (store a i v) i w) (store a i w))))
(check-sat)
; Expected: unsat (store overwrite axiom)
(exit)
