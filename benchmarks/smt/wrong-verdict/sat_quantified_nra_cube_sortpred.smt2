(set-logic ALL)
(set-info :status sat)
(declare-sort V 0)
(declare-fun P (V) Bool)
(declare-const b Real)
(declare-const c Real)
(assert (forall ((v V)) (P v)))
(assert (> b 6.0))
(assert (> c 1.0))
(assert (forall ((y Real)) (or (> c 0.0) (> (* y y) 4.0))))
(assert (forall ((x Real)) (or (> b 5.0) (> (* x x x) 8.0))))
(check-sat)
