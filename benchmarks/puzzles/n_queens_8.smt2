; Author: Andrew Yates <andrewyates.name@gmail.com>
; 8-queens encoded as distinct(row) + distinct(row+col) + distinct(row-col).
; Z3 solves in <0.1s. AY performance tracked by #8762.
(set-logic QF_LIA)
(declare-const q0 Int)
(declare-const q1 Int)
(declare-const q2 Int)
(declare-const q3 Int)
(declare-const q4 Int)
(declare-const q5 Int)
(declare-const q6 Int)
(declare-const q7 Int)
(assert (and (>= q0 0) (<= q0 7)))
(assert (and (>= q1 0) (<= q1 7)))
(assert (and (>= q2 0) (<= q2 7)))
(assert (and (>= q3 0) (<= q3 7)))
(assert (and (>= q4 0) (<= q4 7)))
(assert (and (>= q5 0) (<= q5 7)))
(assert (and (>= q6 0) (<= q6 7)))
(assert (and (>= q7 0) (<= q7 7)))
(assert (distinct q0 q1 q2 q3 q4 q5 q6 q7))
(assert (distinct (+ q0 0) (+ q1 1) (+ q2 2) (+ q3 3) (+ q4 4) (+ q5 5) (+ q6 6) (+ q7 7)))
(assert (distinct (- q0 0) (- q1 1) (- q2 2) (- q3 3) (- q4 4) (- q5 5) (- q6 6) (- q7 7)))
(check-sat)
