(set-info :status sat)
(set-logic QF_LIA)
; 5 distinct integers in range [1,5]
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const d Int)
(declare-const e Int)
(assert (distinct a b c d e))
(assert (>= a 1))
(assert (<= a 5))
(assert (>= b 1))
(assert (<= b 5))
(assert (>= c 1))
(assert (<= c 5))
(assert (>= d 1))
(assert (<= d 5))
(assert (>= e 1))
(assert (<= e 5))
(check-sat)
(exit)
