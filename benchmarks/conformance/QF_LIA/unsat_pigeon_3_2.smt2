(set-info :status unsat)
(set-logic QF_LIA)
; Pigeonhole: 3 pigeons, 2 holes -- impossible to assign distinctly
(declare-const p1 Int)
(declare-const p2 Int)
(declare-const p3 Int)
(assert (>= p1 1))
(assert (<= p1 2))
(assert (>= p2 1))
(assert (<= p2 2))
(assert (>= p3 1))
(assert (<= p3 2))
(assert (distinct p1 p2 p3))
(check-sat)
(exit)
