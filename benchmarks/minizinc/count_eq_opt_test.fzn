% Test count_eq with optimization: maximize the count of x[i] == 3
% x = [x1, x2, x3] where x_i in [0..4], count(x_i == 3) = obj, maximize obj
var 0..4: x1 :: output_var;
var 0..4: x2 :: output_var;
var 0..4: x3 :: output_var;
var 0..3: obj :: output_var;
array [1..3] of var int: xs = [x1, x2, x3];
constraint fzn_count_eq(xs, 3, obj);
solve maximize obj;
