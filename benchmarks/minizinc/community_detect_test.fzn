constraint int_eq_reif(c3, 3, ind_3_3);
constraint bool2int(ind_3_3, iind_3_3);
constraint int_eq_reif(c4, 3, ind_3_4);
constraint bool2int(ind_3_4, iind_3_4);
constraint int_eq_reif(c5, 3, ind_3_5);
constraint bool2int(ind_3_5, iind_3_5);
constraint int_eq_reif(c6, 3, ind_3_6);
constraint bool2int(ind_3_6, iind_3_6);
constraint int_eq_reif(c7, 3, ind_3_7);
constraint bool2int(ind_3_7, iind_3_7);
constraint int_eq_reif(c8, 3, ind_3_8);
constraint bool2int(ind_3_8, iind_3_8);
constraint int_eq_reif(c9, 3, ind_3_9);
constraint bool2int(ind_3_9, iind_3_9);
constraint int_eq_reif(c10, 3, ind_3_10);
constraint bool2int(ind_3_10, iind_3_10);
constraint int_eq_reif(c11, 3, ind_3_11);
constraint bool2int(ind_3_11, iind_3_11);
constraint int_eq_reif(c12, 3, ind_3_12);
constraint bool2int(ind_3_12, iind_3_12);
constraint int_eq_reif(c1, 4, ind_4_1);
constraint bool2int(ind_4_1, iind_4_1);
constraint int_eq_reif(c2, 4, ind_4_2);
constraint bool2int(ind_4_2, iind_4_2);
constraint int_eq_reif(c3, 4, ind_4_3);
constraint bool2int(ind_4_3, iind_4_3);
constraint int_eq_reif(c4, 4, ind_4_4);
constraint bool2int(ind_4_4, iind_4_4);
constraint int_eq_reif(c5, 4, ind_4_5);
constraint bool2int(ind_4_5, iind_4_5);
constraint int_eq_reif(c6, 4, ind_4_6);
constraint bool2int(ind_4_6, iind_4_6);
constraint int_eq_reif(c7, 4, ind_4_7);
constraint bool2int(ind_4_7, iind_4_7);
constraint int_eq_reif(c8, 4, ind_4_8);
constraint bool2int(ind_4_8, iind_4_8);
constraint int_eq_reif(c9, 4, ind_4_9);
constraint bool2int(ind_4_9, iind_4_9);
constraint int_eq_reif(c10, 4, ind_4_10);
constraint bool2int(ind_4_10, iind_4_10);
constraint int_eq_reif(c11, 4, ind_4_11);
constraint bool2int(ind_4_11, iind_4_11);
constraint int_eq_reif(c12, 4, ind_4_12);
constraint bool2int(ind_4_12, iind_4_12);

% Symmetry breaking: lex ordering on cluster indicator columns
constraint fzn_lex_lesseq_int([iind_2_1, iind_2_2, iind_2_3, iind_2_4, iind_2_5, iind_2_6, iind_2_7, iind_2_8, iind_2_9, iind_2_10, iind_2_11, iind_2_12], [iind_1_1, iind_1_2, iind_1_3, iind_1_4, iind_1_5, iind_1_6, iind_1_7, iind_1_8, iind_1_9, iind_1_10, iind_1_11, iind_1_12]);
constraint fzn_lex_lesseq_int([iind_3_1, iind_3_2, iind_3_3, iind_3_4, iind_3_5, iind_3_6, iind_3_7, iind_3_8, iind_3_9, iind_3_10, iind_3_11, iind_3_12], [iind_2_1, iind_2_2, iind_2_3, iind_2_4, iind_2_5, iind_2_6, iind_2_7, iind_2_8, iind_2_9, iind_2_10, iind_2_11, iind_2_12]);
constraint fzn_lex_lesseq_int([iind_4_1, iind_4_2, iind_4_3, iind_4_4, iind_4_5, iind_4_6, iind_4_7, iind_4_8, iind_4_9, iind_4_10, iind_4_11, iind_4_12], [iind_3_1, iind_3_2, iind_3_3, iind_3_4, iind_3_5, iind_3_6, iind_3_7, iind_3_8, iind_3_9, iind_3_10, iind_3_11, iind_3_12]);

% Value precedence: first node is in cluster 1
constraint int_eq(c1, 1);

solve maximize obj;
