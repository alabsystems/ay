(set-logic HORN)
(declare-fun Inv (Int) Bool)
(assert (forall ((x Int)) (=> (= x 0) (Inv x))))
(assert (forall ((x Int) (x1 Int))
  (=> (and (Inv x) (< x 5) (= x1 (+ x 1))) (Inv x1))))
(assert (forall ((x Int) (x1 Int))
  (=> (and (Inv x) (>= x 5) (= x1 (+ x 10))) (Inv x1))))
(assert (forall ((x Int)) (=> (and (Inv x) (>= x 20)) false)))
(check-sat)
