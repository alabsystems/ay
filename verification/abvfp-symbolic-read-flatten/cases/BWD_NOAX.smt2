(set-logic QF_ABV)
(declare-fun A () (Array (_ BitVec 32) (_ BitVec 8)))
(declare-fun K () (Array (_ BitVec 32) (_ BitVec 8)))
(declare-fun i () (_ BitVec 32))
(declare-fun j () (_ BitVec 32))
(declare-fun r1 () (_ BitVec 8))
(declare-fun r2 () (_ BitVec 8))
(assert (not (=> (and (and (bvult r1 r2) (= (bvadd r1 r2) ((_ extract 7 0) i)) (bvuge r2 ((_ extract 7 0) j))) (= A (store (store K j r2) i r1))) (and (bvult (select A i) (select A j)) (= (bvadd (select A i) (select A j)) ((_ extract 7 0) i)) (bvuge (select A j) ((_ extract 7 0) j))))))
(check-sat)
