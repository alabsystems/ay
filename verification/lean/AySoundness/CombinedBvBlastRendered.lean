  · subst h; cases hv0 : (m.α 1) <;> cases hv1 : (m.α 2) <;> simp_all [clauseSat, litSat, atomVal, m.respects_0]
  · subst h; cases hv0 : (m.α 1) <;> cases hv1 : (m.α 2) <;> simp_all [clauseSat, litSat, atomVal, m.respects_0]
  · subst h; cases hv0 : (m.α 1) <;> cases hv1 : (m.α 2) <;> simp_all [clauseSat, litSat, atomVal, m.respects_0]
  · subst h; cases hv0 : (m.α 1) <;> cases hv1 : (m.α 2) <;> simp_all [clauseSat, litSat, atomVal, m.respects_0]
  · subst h; cases hv2 : (m.α 3) <;> cases hv2 : (m.α 3) <;> simp_all [clauseSat, litSat, atomVal, m.respects_1]
  · subst h; cases hv2 : (m.α 3) <;> cases hv2 : (m.α 3) <;> simp_all [clauseSat, litSat, atomVal, m.respects_1]

/-- No gate-respecting assignment satisfies the obligation — bit-blasting
