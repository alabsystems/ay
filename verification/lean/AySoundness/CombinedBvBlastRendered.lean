/-- A gate-respecting assignment: `α` plus, per gate, a proof that the
    output bit equals `gateEval` of its inputs. -/
structure Val where
  α : Nat → Bool
  respects_0 : α 3 = ((α 1) && (α 2))
  respects_1 : α 4 = (!(Bool.xor (α 3) (α 3)))

def atomVal (m : Val) (n : Nat) : Bool := m.α n

/-- A witness assignment (topological gate eval over all-false inputs): it
    certifies `Val` is inhabited, so `no_model` below is non-vacuous. -/
def wα : Nat → Bool := fun n => match n with
  | 3 => false
  | 4 => true
  | _ => false

theorem val_inhabited : Nonempty Val :=
  ⟨{ α := wα, respects_0 := by decide, respects_1 := by decide }⟩

