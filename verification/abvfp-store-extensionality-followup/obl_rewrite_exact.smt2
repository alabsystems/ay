    (ite (= off (bvadd off (_ bv1 32))) (= ((_ extract 7 0) q) ((_ extract 15 8) q)) (and (= ((_ extract 7 0) q) (select (select mem6 base) off)) (= ((_ extract 15 8) q) (select (select mem6 base) (bvadd off (_ bv1 32))))))
