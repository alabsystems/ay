pseudo-Boolean proof version 3.0
% The one-knob control: `order.pbp` with `fresh_right w1 w2;` -- two genuinely fresh variables --
% and nothing else changed. The transitivity proofgoals are then the real ones, the empty
% `proof ... qed;` no longer discharges them, and the UNFIXED checker refuses this too. That is
% what pins the forgery to the UNVALIDATED LIST rather than to the bogus `def` rows or to `dom`
% in general.
f 3;

def_order bogus
    vars
        left u1 u2;
        right v1 v2;
        aux;
    end;

    def
        1 u1 1 u2 1 v1 1 ~v2 >= 1;
        1 u1 1 ~u2 1 ~v1 1 ~v2 >= 1;
        1 ~u1 1 ~u2 1 ~v1 1 v2 >= 1;
        1 ~u1 1 u2 1 v1 1 v2 >= 1;
    end;

    transitivity
        vars
            fresh_right w1 w2;
        end;
        proof
        qed;
    end;
end;

load_order bogus x1 x2;

dom >= 1 : x1 -> x2 x2 -> ~x1 : subproof
    proofgoal #5
        pol -4 2 d;
        pol -4 2 d;
        pol -4 2 d;
        pol -4 2 d;
        pol -4 -3 + s;
        pol -3 -2 + s;
        pol -1 -2 +;
    qed : -1;
qed;

output NONE;
conclusion UNSAT : -1;
end pseudo-Boolean proof;
